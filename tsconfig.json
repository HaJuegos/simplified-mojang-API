{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2020",
        "moduleResolution": "node",
        "rootDir": "./src",
        "outDir": "./dist",
        "lib": [ "ES2020", "dom" ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "allowJs": true,
        "checkJs": true,
        "noImplicitAny": true,
        "sourceMap": false
    },
    "include": [ "src/**/*" ],
    "exclude": [ "node_modules", "dist" ]
}