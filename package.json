{
    "name": "simplified-mojang-api",
    "version": "0.0.69",
    "description": "A TypeScript API that simplifies the event logic and common tools of Mojang's Minecraft Bedrock Script API (@minecraft/server), for informal or professional use.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HaJuegos/simplified-mojang-API.git"
    },
    "bugs": {
        "url": "https://github.com/HaJuegos/simplified-mojang-API/issues"
    },
    "homepage": "https://github.com/HaJuegos/simplified-mojang-API#readme",
    "files": [
        "dist",
        "structures",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "node scripts/clean.mjs && node scripts/bundle.mjs && tsc --emitDeclarationOnly",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm build"
    },
    "author": "HaJuegos",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "scripting",
        "script-api",
        "addon",
        "api",
        "events",
        "wrapper",
        "mojang",
        "typescript"
    ],
    "devDependencies": {
        "@minecraft/debug-utilities": "1.0.0-beta.1.26.60-stable",
        "@minecraft/gameplay-utilities": "1.3.1",
        "@minecraft/server": "2.12.0-beta.1.26.60-stable",
        "@minecraft/server-gametest": "1.0.0-beta.1.26.60-stable",
        "@minecraft/server-graphics": "1.1.0-beta.1.26.60-stable",
        "@minecraft/server-net": "1.0.0-beta.1.26.60-stable",
        "@minecraft/server-ui": "2.4.0-beta.1.26.60-stable",
        "@minecraft/vanilla-data": "1.26.60",

        "@types/node": "^25.4.0",
        "esbuild": "^0.28.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@minecraft/server": "2.12.0-beta.1.26.60-stable",
        "@minecraft/server-ui": "2.4.0-beta.1.26.60-stable",
        "@minecraft/server-gametest": "1.0.0-beta.1.26.60-stable",
        "@minecraft/debug-utilities": "1.0.0-beta.1.26.60-stable",
        "@minecraft/vanilla-data": "1.26.60"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    },
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@12.15.0"
}
